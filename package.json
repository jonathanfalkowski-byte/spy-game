{
  "name": "eve-opening",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/reader-art-manifest.mjs --check && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check:references": "node scripts/check-references.mjs",
    "qa:self": "vitest --config vitest.qa.config.ts run tests/qa/qa-m1.test.ts --reporter=dot",
    "qa:fast": "vitest --config vitest.qa.config.ts run tests/qa/qa-fast.qa.ts --reporter=dot",
    "qa:story": "vitest --config vitest.qa.config.ts run tests/qa/qa-story.qa.ts --reporter=dot",
    "qa:deep": "vitest --config vitest.qa.config.ts run tests/qa/qa-deep.qa.ts --reporter=dot",
    "qa:benchmark": "vitest --config vitest.qa.config.ts run tests/qa/qa-benchmark.qa.ts --reporter=dot",
    "qa:replay": "node scripts/qa-replay.mjs",
    "qa:opening-cinematic": "node scripts/opening-cinematic-gate.mjs",
    "qa:opening-visual": "node scripts/opening-visual-gate.mjs",
    "qa:opening-visual-occupancy": "node scripts/opening-visual-gate.mjs",
    "qa:narrative:prepare": "node scripts/qa-narrative.mjs prepare",
    "qa:narrative:test": "node scripts/qa-narrative.mjs test",
    "qa:narrative": "node scripts/qa-narrative.mjs narrative",
    "qa:narrative:deep": "node scripts/qa-narrative.mjs deep",
    "qa:narrative:pilot": "node scripts/qa-narrative.mjs pilot m2.1",
    "qa:narrative:pilot:test": "vitest --config vitest.qa.config.ts run tests/qa/m2-pilot-plan.qa.ts tests/qa/m2-pilot-run.test.ts --reporter=dot",
    "qa:narrative:preflight": "vitest --config vitest.qa.config.ts run tests/qa/m2-preflight.qa.ts --reporter=dot"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
